FLUX2_SRC=/path/to/official/flux2
PATCHWAM_TRANSFORMER=/path/to/flux-2-klein-base-4b.safetensors
PATCHWAM_AUTOENCODER=/path/to/ae.safetensors
PATCHWAM_TEXT_ENCODER=/path/to/Qwen3-4B
# Optional VLM assets:
PATCHWAM_VLM=/path/to/Qwen3-VL-4B-Instruct
# Original RoboDojo update budget:
# PATCHWAM_MAX_UPDATES=...
PATCHWAM_DATA_ROOT=/path/to/lerobot/dataset
PATCHWAM_NORM_STATS=/path/to/statistics.json
PATCHWAM_NONIDLE_FILTER=/path/to/nonidle_ranges.json
# Closed-loop evaluation:
PATCHWAM_POLICY=/path/to/policy_0.safetensors
PATCHWAM_ROBOTWIN_ROOT=/path/to/RoboTwin
PATCHWAM_ROBOTWIN_TASK=adjust_bottle
PATCHWAM_ROBOTWIN_TASK_CONFIG=/path/to/task_config.yml
PATCHWAM_INSTRUCTION='Adjust the bottle.'
PATCHWAM_ROBOCASA_TASK=PnPCounterToCab
